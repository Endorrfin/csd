{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "serve:ssr:ui": "node dist/ui/server/server.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test:ci": "ng test --no-watch",
    "format:check": "prettier --check \"src/**/*.scss\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:ci && npm run build",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-server": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/ssr": "^21.2.15",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "express": "^5.1.0",
    "lucide-angular": "^1.0.0",
    "ngx-quill": "^30.0.1",
    "ngx-translate": "^0.0.1-security",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "serverless-http": "^4.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.17.19",
    "@types/quill": "^2.0.14",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^28.0.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  }
}
