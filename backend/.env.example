DB_HOST=localhost
# DB_PORT: 5432 = Homebrew postgres@14 (README default); 5433 = Docker host:container mapping.
DB_PORT=5432
DB_USERNAME=csd_user
DB_PASSWORD=csd_password
DB_NAME=csd_db
# JWT_SECRET — 256-bit signing secret for HS256 JWTs. Generate per environment:
#   openssl rand -hex 32
#   # or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse across environments. Never commit a real value. App will refuse
# to start if missing or shorter than 32 chars (see assertRequiredEnv()).
JWT_SECRET=

# === Super-admin bootstrap (used ONLY by seed-super-admin script) ===
# Set inline when running: SUPER_ADMIN_EMAIL=... SUPER_ADMIN_PASSWORD=... npm run seed:super-admin
# Do NOT keep these in committed .env files — they are one-shot, not runtime config.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

FRONTEND_URL=http://localhost:4200
