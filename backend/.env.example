DB_HOST=localhost
# DB_PORT: 5432 = Homebrew postgres@14 (README default); 5433 = Docker host:container mapping.
DB_PORT=5432
DB_USERNAME=csd_user
DB_PASSWORD=csd_password
DB_NAME=csd_db

# Not needed locally: db-ssl.ts returns ssl:false when NODE_ENV !== 'production'.
# In production the RDS server certificate is VERIFIED against the AWS CA bundle
# at backend/certs/rds-ca-eu-central-1.pem — see backend/certs/README.md. If the
# bundle cannot be read the app refuses to start rather than falling back to an
# unverified connection (same policy as assertRequiredEnv()).
# Both overrides below are optional; leave them empty unless you need them.
#   DB_CA_BUNDLE       — inline PEM, wins over the file. Ships a rotated CA
#                        without a code change.
#   DB_CA_BUNDLE_PATH  — alternative path, absolute or relative to backend/.
# DB_CA_BUNDLE=
# DB_CA_BUNDLE_PATH=
# JWT_SECRET — 256-bit signing secret for HS256 JWTs. Generate per environment:
#   openssl rand -hex 32
#   # or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse across environments. Never commit a real value. App will refuse
# to start if missing or shorter than 32 chars (see assertRequiredEnv()).
JWT_SECRET=

# === Super-admin bootstrap (used ONLY by seed-super-admin script) ===
# Set inline when running: SUPER_ADMIN_EMAIL=... SUPER_ADMIN_PASSWORD=... npm run seed:super-admin
# Do NOT keep these in committed .env files — they are one-shot, not runtime config.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# FRONTEND_URL — comma-separated CORS allowlist; the FIRST entry is the canonical
# public URL used in user-facing links (password reset). No '*' fallback: in
# production the app refuses to start without it (see assertRequiredEnv()).
# Prod example: FRONTEND_URL=https://www.csd-fund.org,https://csd-fund.org
FRONTEND_URL=http://localhost:4200

# === Recovery needs form (PR-2) ===
# AWS_S3_PRIVATE_BUCKET — private bucket for recovery uploads (photos + defect
# acts with PII). MUST be a private bucket (no public read policy) with CORS
# allowing POST from the site origin. Presigned POST uploads / presigned GET
# reads only. Defaults to 'csd-media-private' in serverless.yml. Leave empty
# locally unless you test uploads against real S3.
AWS_S3_PRIVATE_BUCKET=
# TURNSTILE_SECRET_KEY — Cloudflare Turnstile secret (server-side siteverify).
# Optional locally: if unset, the TurnstileGuard bypasses verification in
# non-production with a warning. In production it must be set or the recovery
# submit/upload endpoints fail closed with 403 (rest of the API is unaffected).
TURNSTILE_SECRET_KEY=

# === Winterization needs form (PR-W1) ===
# WINTERIZATION_HOUSEHOLD_ENABLED — feature gate for household / individual
# applicants («Домогосподарство / Фізична особа», implementation-plan §7). The
# scenario is fully implemented (DTO, columns, UI card) but switched OFF:
# WinterizationService answers 422 for applicantType='household' unless this is
# exactly 'true'. Anything else (unset, 'false', '1', 'yes') keeps it closed.
#
# Do NOT flip this without a management decision: direct assistance to
# individuals triggers extra Ukrainian tax-reporting duties, and the household
# block collects sensitive vulnerability data that must first be reconciled with
# the CSD confidentiality policy (CSD-POL-07) and a retention period.
WINTERIZATION_HOUSEHOLD_ENABLED=false
